# 이 파일을 .env.local로 복사한 뒤 Dashboard의 실제 값으로 바꾼다.
# Vercel Preview/Production에는 아래 앱 runtime 7개만 등록한다.
NEXT_PUBLIC_STORAGE_MODE=hosted
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUPABASE_BROWSER_SAFE_ANON_OR_PUBLISHABLE_KEY
NEXT_PUBLIC_OPERATOR_NAME=PUBLIC_LEGAL_OR_BUSINESS_OPERATOR_NAME
NEXT_PUBLIC_SUPPORT_EMAIL=support@YOUR_DOMAIN

# 폐쇄 베타 기본값. true로 바꾸기 전에 Supabase Auth 가입 허용, SMTP,
# 가입 동의 기록 migration과 운영 정책을 함께 검증한다.
NEXT_PUBLIC_BETA_SIGNUP_ENABLED=false

# 계정 탈퇴 API 전용 서버 비밀값. 아래 placeholder는 .env.local/Vercel에서
# 실제 값으로 바꾸되 NEXT_PUBLIC_* 이름을 붙이거나 Git에 커밋하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SB_SECRET_OR_SERVICE_ROLE_JWT

# 로컬 CLI가 원격 Auth config와 초대 목적지를 고정할 때만 쓰는 origin.
# Vercel 환경변수에는 넣지 않는다. 도메인 연결 뒤 최종 origin으로 바꾸고
# supabase:config:push를 다시 실행한다.
SUPABASE_AUTH_SITE_URL=https://bootstrap.invalid
# 실제 Preview를 만든 뒤 guard가 안내하는 project-ref 결합 확인값을 현재 셸에만 둔다.
# ILGAMCHECK_AUTH_CONFIG_PUSH_ACK=PUSH_CLOSED_BETA_AUTH_CONFIG_TO_PROJECT_REF

# DB 비밀번호/URL과 SMTP 비밀번호도 NEXT_PUBLIC_* 또는 Git에 넣지 않는다.
# SMTP 자격증명은 Supabase Auth SMTP 설정에만 입력한다.
# 최종 베타 DNS/evidence 검사에는 사업자가 지정한 값을 사용한다:
# ILGAMCHECK_FINAL_ORIGIN=https://YOUR_FINAL_DOMAIN
# ILGAMCHECK_SMTP_FROM_DOMAIN=mail.YOUR_DOMAIN
# ILGAMCHECK_SMTP_RETURN_PATH_DOMAIN=bounce.YOUR_DOMAIN
# ILGAMCHECK_SMTP_DMARC_DOMAIN=YOUR_DOMAIN
# ILGAMCHECK_SMTP_DKIM_SELECTORS=selector1,selector2
# ILGAMCHECK_SMTP_EVIDENCE_PATH=D:\EncryptedOps\ilgamcheck\smtp-evidence.json

# 배포 후 로컬에서만 사용하는 smoke 대상 주소. Vercel 환경변수일 필요는 없다.
# DEPLOYMENT_URL=https://YOUR_PREVIEW.vercel.app

# 선택: 실제 Hosted A/B 검증 전용 계정. Vercel에 등록하지 말고 로컬 .env.local에만 둔다.
# 이 검사는 A 계정의 작업공간을 덮어쓴다. 운영 계정은 절대 사용하지 않는다.
# ILGAMCHECK_TEST_A_EMAIL=dedicated-a@example.com
# ILGAMCHECK_TEST_A_PASSWORD=LONG_RANDOM_PASSWORD_A
# ILGAMCHECK_TEST_B_EMAIL=dedicated-b@example.com
# ILGAMCHECK_TEST_B_PASSWORD=LONG_RANDOM_PASSWORD_B
# 파괴적 Hosted 검증 동의값은 파일에 저장하지 않고 실행 직전 현재 셸에만 둔다.

# 선택: 저장소 밖 암호화 폴더로 public logical dump를 만들 때만 로컬에서 사용한다.
# ILGAMCHECK_BACKUP_DIR=D:\EncryptedBackups\ilgamcheck
# ILGAMCHECK_BACKUP_ACK=I_UNDERSTAND_EXPORT_CONTAINS_CUSTOMER_DATA

# 선택: 별도 recovery 프로젝트 복원 검증. production/recovery ref는 반드시 달라야 한다.
# ILGAMCHECK_PRODUCTION_PROJECT_REF=PRODUCTION_PROJECT_REF_20_CHARS
# ILGAMCHECK_RECOVERY_PROJECT_REF=RECOVERY_PROJECT_REF_20_CHARS
# ILGAMCHECK_RECOVERY_DEPLOYMENT_URL=https://YOUR_RECOVERY_PREVIEW
# 실행 동의값은 .env.local이 아니라 현재 셸에만 둔다:
# ILGAMCHECK_RECOVERY_VERIFY_ACK=VERIFY_DEDICATED_RECOVERY_PROJECT

# 선택: 최종 외부 베타 직전 정책·탈퇴·backup/recovery 운영 evidence.
# 저장소 밖 암호화 폴더의 절대 경로만 허용한다.
# ILGAMCHECK_OPERATIONAL_EVIDENCE_PATH=D:\EncryptedOps\ilgamcheck\operational-evidence.json
