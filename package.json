{
  "name": "ilgamcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "node scripts/clean-sites-output.mjs && vite build --mode sites-client && vite build --mode sites-worker",
    "mobile:sync": "npm run build:sites && npx cap sync",
    "mobile:verify": "node scripts/mobile-verify.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare build && wrangler dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "node e2e/run-release.mjs",
    "test:e2e:release": "node e2e/run-release.mjs",
    "audit:prod": "npm audit --omit=dev",
    "check:deploy": "node scripts/deploy-preflight.mjs && npm run build",
    "check:deploy-env": "node scripts/check-deploy-env.mjs",
    "hosted:env:init": "node scripts/init-hosted-env.mjs",
    "hosted:bootstrap": "node scripts/hosted-bootstrap.mjs",
    "status:domain-ready": "node scripts/domain-ready-status.mjs",
    "supabase:auth:readback": "node scripts/supabase-auth-readback.mjs",
    "runtime:readback": "node scripts/runtime-contract-readback.mjs",
    "check:release": "node scripts/release-gate.mjs",
    "smoke:remote": "node scripts/remote-smoke.mjs",
    "smoke:sites": "node scripts/sites-remote-smoke.mjs",
    "verify:hosted": "node scripts/verify-hosted-runtime.mjs",
    "verify:hosted:ephemeral": "node scripts/verify-hosted-runtime-ephemeral.mjs",
    "beta:invite": "node scripts/beta-invite.mjs",
    "smtp:dns:verify": "node scripts/smtp-dns-verify.mjs",
    "smtp:evidence:verify": "node scripts/smtp-evidence-verify.mjs",
    "policy:manifest:verify": "node scripts/policy-publication-manifest.mjs",
    "operational:evidence:verify": "node scripts/operational-evidence-verify.mjs",
    "check:external-beta": "node scripts/external-beta-check.mjs",
    "check:external-inputs": "node scripts/external-intake.mjs",
    "supabase:login": "node scripts/isolated-cli.mjs supabase-login",
    "supabase:link": "node scripts/supabase-link.mjs",
    "supabase:push:dry": "node scripts/supabase-push.mjs --dry-run",
    "supabase:push": "node scripts/supabase-push.mjs --apply",
    "supabase:config:push": "node scripts/supabase-config-push.mjs",
    "supabase:migrations": "node scripts/isolated-cli.mjs supabase-migrations",
    "supabase:backup": "node scripts/supabase-backup.mjs",
    "supabase:restore:verify:dry": "node scripts/supabase-restore-verify.mjs --dry-run",
    "supabase:restore:verify": "node scripts/supabase-restore-verify.mjs --apply",
    "vercel:login": "node scripts/isolated-cli.mjs vercel-login",
    "vercel:link": "node scripts/isolated-cli.mjs vercel-link",
    "vercel:env:push:preview": "node scripts/vercel-env-push.mjs --target preview",
    "vercel:env:push:production": "node scripts/vercel-env-push.mjs --target production",
    "vercel:preview": "node scripts/vercel-deploy.mjs --target preview",
    "vercel:production": "node scripts/vercel-deploy.mjs --target production"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@next/env": "16.3.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/supabase-js": "2.112.3",
    "date-fns": "4.4.0",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "pretendard": "^1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "29.0.1",
    "sharp": "^0.35.3",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "4.1.10",
    "wrangler": "^4.125.0"
  }
}
