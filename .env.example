# 기본은 즉시 실행 가능한 단일 브라우저 로컬 모드다.
NEXT_PUBLIC_STORAGE_MODE=local

# 아래 값은 창업자 소유 Supabase 프로젝트를 Seoul(ap-northeast-2) 리전에 만들고,
# migration·RLS·두 계정 격리 테스트까지 끝낸 뒤에만 활성화한다.
# NEXT_PUBLIC_STORAGE_MODE=hosted
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=PUBLIC_ANON_KEY

# service_role, FCM 서비스 계정, VAPID private key, 암호화 키는 NEXT_PUBLIC_* 또는 Git에 넣지 않는다.
# 예약 Web Push는 서버/Edge Function에서만 구현·검증한다.

# 실제 Preview 배포는 .env.hosted.example을 복사해서 사용한다.

# 베타 의견/설문 접수용 구글 폼. 비워두면 페이지는 "접수 준비 중"으로 뜨고 복사 버튼만 제공한다.
# NEXT_PUBLIC_FEEDBACK_FORM_URL=https://docs.google.com/forms/d/e/FORM_ID/viewform
# 아래 entry ID는 구글 폼의 "미리 채운 링크 가져오기"에서 얻는다. 선택 항목(객관식)만 프리필한다.
# NEXT_PUBLIC_FEEDBACK_ENTRY_TYPE=1234567890
# NEXT_PUBLIC_FEEDBACK_ENTRY_SCREEN=1234567891
# NEXT_PUBLIC_FEEDBACK_ENTRY_USAGE=1234567892
# NEXT_PUBLIC_FEEDBACK_ENTRY_SCALE=1234567893
# NEXT_PUBLIC_FEEDBACK_ENTRY_PRICE=1234567894
# NEXT_PUBLIC_FEEDBACK_ENTRY_FOUNDER=1234567895
# 자유 서술(자세한 내용)과 이메일은 개인정보가 섞일 수 있어 URL에 절대 넣지 않는다. entry ID도 두지 않는다.
